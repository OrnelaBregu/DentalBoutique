# Use OpenRouter (recommended) or OpenAI
OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Optional: directory where Chroma stores the vector index
# VECTOR_STORE_PATH=./data/chroma

# Optional: path to directory containing company_*.md documents
# DOCUMENTS_PATH=.

# Optional: model names
# LLM model (OpenRouter uses provider/model, e.g. openai/gpt-4o)
# LLM_MODEL=openai/gpt-4o
# Local text embedding model
# TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Local multimodal model for image indexing/retrieval
# IMAGE_EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32
# Optional local cache for Hugging Face/SentenceTransformer models
# MODEL_CACHE_DIR=./data/model_cache

# Optional: number of chunks to retrieve per query
# TOP_K=5
# IMAGE_TOP_K=3
# IMAGE_MIN_SIMILARITY=0.22

# Optional feedback loop settings (thumbs up/down learning)
# FEEDBACK_FILE_PATH=./data/feedback.jsonl
# FEEDBACK_TOP_K=2
# FEEDBACK_MIN_SIMILARITY=0.35
